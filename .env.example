# Anthropic credential for live frame-accurate vision screening.
# Without it, Continuo runs a clearly-labelled mock screening so the full
# workflow (bible -> screen -> report card -> prompt repair) still works offline.
ANTHROPIC_API_KEY=

# Optional overrides
# CONTINUO_VISION_MODEL=claude-opus-4-8
# CONTINUO_DATA_DIR=./data

# QC metering — estimated cost per live vision screening (USD).
# CONTINUO_VISION_COST_PER_SCREEN=0.02

# One-click corrected regeneration. Defaults to a dry-run provider (no external
# call, no credits). Set to "http" plus an endpoint + key to submit to a real
# text-to-video provider (Kling / Higgsfield / ...).
# CONTINUO_REGEN_PROVIDER=dry_run   # dry_run | http | kling | higgsfield
# CONTINUO_REGEN_ENDPOINT=https://api.provider.example/v1/generate   # for provider=http
# CONTINUO_REGEN_API_KEY=

# Submit-then-poll providers. Set the submit + status URLs (status is a template
# containing {id}) and the key, then select the provider above. Verify the exact
# URLs and payload against the provider's current API docs before going live.
# CONTINUO_REGEN_POLL_INTERVAL=2.0
# CONTINUO_REGEN_MAX_POLLS=30
# CONTINUO_KLING_SUBMIT_URL=
# CONTINUO_KLING_STATUS_URL=https://.../jobs/{id}
# CONTINUO_KLING_API_KEY=
# CONTINUO_HIGGSFIELD_SUBMIT_URL=
# CONTINUO_HIGGSFIELD_STATUS_URL=https://.../jobs/{id}
# CONTINUO_HIGGSFIELD_API_KEY=

# Usage-based billing. With STRIPE_API_KEY set, billable actions (live
# screenings, regenerations) push Stripe meter events; otherwise they append to
# a local JSONL ledger. Set CONTINUO_BILLING=off to disable.
# CONTINUO_BILLING=auto
# STRIPE_API_KEY=
# STRIPE_CUSTOMER=cus_...

# Clip decoding uses a system ffmpeg if present, else `pip install imageio-ffmpeg`.
